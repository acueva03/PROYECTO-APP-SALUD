# Copia este archivo como .env y cambia el valor. NO subas .env a GitHub.
   SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
   # PRODUCCION=1   (solo en el servidor real con HTTPS)

   # --- Solo en el servidor en la nube (en local no hacen falta) ---
   # DATABASE_URL=postgresql://usuario:clave@servidor/basededatos?sslmode=require
   #   (base de datos común; si no se pone, se usa el archivo SQLite local app_salud.db)
   # FIREBASE_CREDENTIALS=   (contenido del JSON de Firebase en una línea, o la ruta a ese archivo; para el push)
   # CRON_TOKEN=             (clave larga y aleatoria; el cron la envía en la cabecera X-Cron-Token a /interno/tick)
